# Data source per domain — mock (default) runs against in-browser fixtures
# (no backend needed); live talks to SearchEngine-BE. They switch independently,
# so e.g. login can be live while search stays on fixtures.
VITE_AUTH_API_MODE=mock
VITE_SPBU_API_MODE=mock

# Only used when either mode above is `live`.
# `dotnet run` serves the API on 5152 (http) / 7185 (https) per launchSettings.json,
# and its CORS policy allows http://localhost:5173.
VITE_API_BASE_URL=http://localhost:5152/api
