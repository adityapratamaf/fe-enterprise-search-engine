# Data source: `mock` runs against in-browser fixtures (no backend, no real
# login); `live` talks to SearchEngine-BE. Defaults to mock.
VITE_API_MODE=mock

# Only used when VITE_API_MODE=live.
# `dotnet run` serves the API on 5152 (http) / 7185 (https) per launchSettings.json,
# and its CORS policy allows http://localhost:5173.
VITE_API_BASE_URL=http://localhost:5152/api
